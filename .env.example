# Supabase Credentials (from your Supabase project API settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gemini AI API Key (from Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEYS=
GEMINI_API_KEY_PROCESS=
GEMINI_API_KEY_COMPLETION=
GEMINI_API_KEY_EVALUATE=
GEMINI_API_KEY_FIX=
GEMINI_API_KEY_ALIGNMENT=
# Optional latency-optimized model used by split generation routes.
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# Optional shared AI concurrency limit. Defaults to one request per distinct key.
AI_CONCURRENCY_LIMIT=1
