# Supabase Credentials (from your Supabase project API settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gemini AI API Key (from Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_PAID_API_KEY=
GEMINI_FREE_API_KEY=
GEMINI_API_KEYS=
GEMINI_API_KEY_PROCESS=
GEMINI_API_KEY_COMPLETION=
GEMINI_API_KEY_EVALUATE=
GEMINI_API_KEY_FIX=
GEMINI_API_KEY_ALIGNMENT=
GEMINI_EVALUATION_MODEL=gemini-2.5-flash-lite
# Optional latency-optimized model used by split generation routes.
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
# Optional model for the teacher-reviewed full-plan improvement preview.
GEMINI_FIX_MODEL=gemini-2.5-flash-lite

# Optional shared AI concurrency limit. Defaults to one request per distinct key.
AI_CONCURRENCY_LIMIT=1

# English Mastery: uses existing Smart Plan Supabase, never a second identity.
EMH_ENABLED=false
EMH_ENV=development
# Local isolated runtime banner; local launcher also enforces loopback and a dedicated VM.
EMH_ISOLATED_LOCAL=false
# Set only after an operator approves a genuine retention policy. Empty blocks uploads.
EMH_RECORDING_POLICY_VERSION=
EMH_RECORDING_RETENTION_DAYS=
# Explicitly isolated staging target; required by import/verification CLI for remote writes.
EMH_STAGING_SUPABASE_URL=
EMH_IMPORT_ACTOR_ID=
EMH_BOOTSTRAP_USER_ID=
# Direct/pooler PostgreSQL URI for the SAME staging project; include sslmode=verify-full.
EMH_STAGING_DATABASE_URL=
# EMH AI is disabled in code. No AI credentials are needed for English Mastery.
